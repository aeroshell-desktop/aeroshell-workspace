<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/x-msdownload">
        <comment>Windows or DOS program</comment>
        <glob-deleteall/>
        <magic-deleteall/>
        <glob pattern="*.cpl" weight="100"/>
        <glob pattern="*.drv" weight="100"/>
        <glob pattern="*.exe" weight="100"/>
        <glob pattern="*.scr" weight="100"/>
    </mime-type>
    <mime-type type="application/x-ms-ne-executable">
        <comment>16-bit Windows program</comment>
        <glob-deleteall/>
        <magic-deleteall/>
        <glob pattern="*.cpl" weight="100"/>
        <glob pattern="*.drv" weight="100"/>
        <glob pattern="*.exe" weight="100"/>
        <glob pattern="*.scr" weight="100"/>
    </mime-type>
    <mime-type type="application/x-ms-dll">
        <comment>Dynamic link library file</comment>
        <icon name="application-x-sharedlib"/>
        <glob-deleteall/>
        <magic-deleteall/>
        <glob pattern="*.dll" weight="100"/>
    </mime-type>
    <mime-type type="application/vnd.microsoft.portable-executable">
        <comment>Windows or EFI program</comment>
        <glob-deleteall/>
        <magic-deleteall/>
        <glob pattern="*.cpl" weight="100"/>
        <glob pattern="*.drv" weight="100"/>
        <glob pattern="*.efi" weight="100"/>
        <glob pattern="*.exe" weight="100"/>
        <glob pattern="*.lib" weight="100"/>
        <glob pattern="*.ocx" weight="100"/>
        <glob pattern="*.scr" weight="100"/>
        <glob pattern="*.sys" weight="100"/>
    </mime-type>
</mime-info>
